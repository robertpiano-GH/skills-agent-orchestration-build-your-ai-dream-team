{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Project Pulse Dashboard",
      "type": "python",
      "request": "launch",
      "program": "-m",
      "args": ["http.server", "5500"],
      "cwd": "${workspaceFolder}/app",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Serving HTTP on.*",
        "uriFormat": "http://localhost:%s/index.html"
      }
    }
  ]
}
